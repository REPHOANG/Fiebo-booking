{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "MyApp"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MyCnn": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": ""
  },
  "EmailSettings": {
    "SmtpServer": "",
    "Port": "",
    "SenderEmail": "",
    "Password": "",
    "SenderName": ""
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": ""
  },
  "OtpSettings": {
    "Length": 6,
    "ExpireMinutes": 5
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "SpeedSMS": {
    "AccessToken": "",
    "Sender": ""
  },
  "FrontendUrl": {
    "ResetPassword": "http://localhost:3000/reset-password"
  }
}
