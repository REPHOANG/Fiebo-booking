# =========================================
# React + ASP.NET: Consistent line endings
# =========================================

# Default: normalize text files
* text=auto

# Force LF for source & config (recommended for cross-platform)
*.cs           text eol=lf
*.csx          text eol=lf
*.csproj       text eol=lf
*.sln          text eol=lf
*.props        text eol=lf
*.targets      text eol=lf
*.config       text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.md           text eol=lf
*.txt          text eol=lf

# Front-end
*.js           text eol=lf
*.jsx          text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf
*.css          text eol=lf
*.scss         text eol=lf
*.html         text eol=lf
*.env          text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf

# Shell scripts (LF)
*.sh           text eol=lf

# Windows scripts (CRLF)
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# =========================================
# Binary files: never modify
# =========================================
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.svg          text eol=lf
*.webp         binary
*.pdf          binary
*.zip          binary
*.7z           binary
*.rar          binary
*.dll          binary
*.exe          binary
*.pdb          binary

# =========================================
# Optional: treat common lockfiles as text
# =========================================
package-lock.json text eol=lf
yarn.lock         text eol=lf
pnpm-lock.yaml    text eol=lf